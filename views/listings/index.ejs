<% layout("/layouts/boilerplate") %>

<style>
    #filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
    }

    .filter {
        text-align: center;
        margin-right: 2.5rem;
        margin-top: 2rem;
        opacity: 0.7;
    }

    .filter:hover {
        opacity: 1;
        cursor: pointer;
    }

    .filter p {
        font-size: 0.8rem;
    }

    .tax-info {
        display: none;
    }

    .tax-toggle {
        border: 1px solid black;
        border-radius: 1rem;
        height: 3.25rem;
        padding: 0.5rem 1rem;
        margin-left: 0;   /* remove the big offset */
        display: flex;
        align-items: center;
    }

    .card-des:hover {
        opacity: 0.6;
    }

</style>

<div id="filters" class="d-flex flex-wrap align-items-center">

    <a href="/listings/category/Trending" class="filter text-decoration-none text-dark">
        <div class="filter-icon"><i class="fa-solid fa-fire"></i></div>
        <p class="filter-text">Trending</p>
    </a>

    <a href="/listings/category/Rooms" class="filter text-decoration-none text-dark">
        <div class="filter-icon"><i class="fa-solid fa-bed"></i></div>
        <p class="filter-text">Rooms</p>
    </a>

    <a href="/listings/category/Iconic Cities" class="filter text-decoration-none text-dark">
        <div class="filter-icon"><i class="fa-solid fa-mountain-city"></i></div>
        <p class="filter-text">Iconic Cities</p>
    </a>

    <a href="/listings/category/Mountains" class="filter text-decoration-none text-dark">
        <div class="filter-icon"><i class="fa-solid fa-mountain"></i></div>
        <p class="filter-text">Mountains</p>
    </a>

    <a href="/listings/category/Castles" class="filter text-decoration-none text-dark">
        <div class="filter-icon"><i class="fa-brands fa-fort-awesome"></i></div>
        <p class="filter-text">Castles</p>
    </a>

    <a href="/listings/category/Amazing Pools" class="filter text-decoration-none text-dark">
        <div class="filter-icon"><i class="fa-solid fa-person-swimming"></i></div>
        <p class="filter-text">Amazing Pools</p>
    </a>

    <a href="/listings/category/Arctic" class="filter text-decoration-none text-dark">
        <div class="filter-icon"><i class="fa-solid fa-snowflake"></i></div>
        <p class="filter-text">Arctic</p>
    </a>

    <a href="/listings/category/Camping" class="filter text-decoration-none text-dark">
        <div class="filter-icon"><i class="fa-solid fa-tent"></i></div>
        <p class="filter-text">Camping</p>
    </a>

    <a href="/listings/category/Farms" class="filter text-decoration-none text-dark">
        <div class="filter-icon"><i class="fa-solid fa-cow"></i></div>
        <p class="filter-text">Farms</p>
    </a>

    <a href="/listings/category/Domes" class="filter text-decoration-none text-dark">
        <div class="filter-icon"><i class="fa-solid fa-igloo"></i></div>
        <p class="filter-text">Domes</p>
    </a>

    <a href="/listings/category/Boats" class="filter text-decoration-none text-dark">
        <div class="filter-icon"><i class="fa-solid fa-ship"></i></div>
        <p class="filter-text">Boats</p>
    </a>

    <div class="tax-toggle d-flex align-items-center">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">

            <label class="form-check-label ms-2" for="switchCheckDefault">
                Display total after taxes
            </label>
        </div>
    </div>

</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for(let listing of allListings) { %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="card col listing-card">
                <% if (listing.image.url) { %>
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_img" style="height: 20rem;">
                <% } else { %>
                    <img src="https://images.unsplash.com/photo-1449844908441-8829872d2607?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="default img" class="card-img-top" style="height: 20rem;">
                <% } %>
                <div class="card-img-overlay card-des"><b><%= listing.description %></b></div>
                <div class="card-body">
                    <p class="card-text">
                        <b><%= listing.title %></b> <br>
                        &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                        <i class="tax-info"> &nbsp; &nbsp+18% GST</i>
                    </p>
                </div>
            </div>
        </a>
    <% } %>
</div>

<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click", () => {
        let taxInfo = document.getElementsByClassName("tax-info");
        for(info of taxInfo) {
            if(info.style.display != "inline") {
                info.style.display = "inline";
            } else {
                info.style.display = "none";
            }
        };
    });
</script>