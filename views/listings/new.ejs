<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3>Create new listing</h3>
        <br><br>
        <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" placeholder="Add a catchy title" name="listing[title]" class="form-control" required>
                <div class="invalid-feedback">Please add a valid Title</div>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="listing[description]" class="form-control" required></textarea>
                <div class="invalid-feedback">Please enter a short description</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Category</label>
                <br>

                <input type="checkbox" name="listing[category][]" value="Trending"
                    <%= (typeof listing !== "undefined" && listing.category.includes("Trending")) ? "checked" : "" %> >
                Trending <br>

                <input type="checkbox" name="listing[category][]" value="Rooms"
                    <%= (typeof listing !== "undefined" && listing.category.includes("Rooms")) ? "checked" : "" %> >
                Rooms <br>

                <input type="checkbox" name="listing[category][]" value="Iconic Cities"
                    <%= (typeof listing !== "undefined" && listing.category.includes("Iconic Cities")) ? "checked" : "" %> >
                Iconic Cities <br>

                <input type="checkbox" name="listing[category][]" value="Mountains"
                    <%= (typeof listing !== "undefined" && listing.category.includes("Mountains")) ? "checked" : "" %> >
                Mountains <br>

                <input type="checkbox" name="listing[category][]" value="Castles"
                    <%= (typeof listing !== "undefined" && listing.category.includes("Castles")) ? "checked" : "" %> >
                Castles <br>

                <input type="checkbox" name="listing[category][]" value="Amazing Pools"
                    <%= (typeof listing !== "undefined" && listing.category.includes("Amazing Pools")) ? "checked" : "" %> >
                Amazing Pools <br>

                <input type="checkbox" name="listing[category][]" value="Arctic"
                    <%= (typeof listing !== "undefined" && listing.category.includes("Arctic")) ? "checked" : "" %> >
                Arctic <br>

                <input type="checkbox" name="listing[category][]" value="Camping"
                    <%= (typeof listing !== "undefined" && listing.category.includes("Camping")) ? "checked" : "" %> >
                Camping <br>

                <input type="checkbox" name="listing[category][]" value="Farms"
                    <%= (typeof listing !== "undefined" && listing.category.includes("Farms")) ? "checked" : "" %> >
                Farms <br>

                <input type="checkbox" name="listing[category][]" value="Domes"
                    <%= (typeof listing !== "undefined" && listing.category.includes("Domes")) ? "checked" : "" %> >
                Domes <br>

                <input type="checkbox" name="listing[category][]" value="Boats"
                    <%= (typeof listing !== "undefined" && listing.category.includes("Boats")) ? "checked" : "" %> >
                Boats <br>
            </div>

            <div class="mb-3">
                <label for="image" class="form-label">Upload Listing Image</label>

                <input 
                    type="file" 
                    name="image" 
                    class="form-control"
                    required
                >
            </div>

            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price</label>
                    <input type="number" placeholder="1200" name="listing[price]" class="form-control" required>
                    <div class="invalid-feedback">Price should be valid</div>
                </div>

                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" placeholder="India" name="listing[country]" class="form-control" required>
                    <div class="invalid-feedback">Country name should be valid</div>
                </div>
            </div>

            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input type="text" placeholder="Jaipur, Rajasthan" name="listing[location]" class="form-control" required>
                <div class="invalid-feedback">Location should be valid</div>
            </div>
                
            <button class="btn btn-dark add-btn mt-3 mb-3">Add</button>
        </form>
    </div>
</div>