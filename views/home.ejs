<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body { 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            height: 100vh; 
            background-color: linear-gradient(135deg, #ffffff 0%, #f5f5f5 50%, #fafafa 100%); 
        }

        p {
            animation-duration: 3s;
            animation-name: slide-in;
            font-size: 5rem;
            font-weight: bold;
            text-align: center;
        }

        p span {
            display: inline-block;
            animation-duration: 3s;
            animation-name: grow-shrink;
        }

        @keyframes slide-in {
            from {
                translate: 150vw 0;
                scale: 200% 1;
            }
            to {
                translate: 0 0;
                scale: 100% 1;
            }
        }

        @keyframes grow-shrink {
            25%, 75% {
                scale: 100%;
            }
            50% {
                scale: 200%;
                color: magenta;
            }
        }

        a {
            text-decoration: none;
            color: #fe424d;
        }

        .title p {
            transition: transform 0.3s ease;
        }

        .title p:hover {
            transform: scale(1.1);
        }
    </style>
</head>

<body>
    <div class="title">
        <a href="/listings">
            <p>
                Wanderlust
            </p>
        </a>
    </div>
</body>
</html>
